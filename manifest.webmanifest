{
  "id": "./",
  "name": "Cyber City Tactics",
  "short_name": "Cyber City",
  "description": "A vector brawler RPG for one or two players, couch or online: a six-district campaign, an open-world Sprawl, Arena waves, driving, drone and flight jobs, skill trees, legendaries and secrets. Plays offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0c0a14",
  "theme_color": "#0c0a14",
  "categories": ["games", "entertainment"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Daily challenge",
      "short_name": "Daily",
      "description": "Today's seeded Arena run",
      "url": "./?go=daily",
      "icons": [{ "src": "icons/shortcut-daily.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "The Sprawl",
      "short_name": "Sprawl",
      "description": "The open world",
      "url": "./?go=sprawl",
      "icons": [{ "src": "icons/shortcut-sprawl.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Arena",
      "short_name": "Arena",
      "description": "Endless waves",
      "url": "./?go=arena",
      "icons": [{ "src": "icons/shortcut-arena.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Codex",
      "short_name": "Codex",
      "description": "Feats, legendaries, bestiary and lore",
      "url": "./?go=codex",
      "icons": [{ "src": "icons/shortcut-codex.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {"src": "screenshots/wide-market.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Mother Vesper's night market under the tunnels"},
    {"src": "screenshots/wide-street.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Two runners in a storm on Rustline"},
    {"src": "screenshots/narrow-play.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Touch controls in portrait"},
    {"src": "screenshots/narrow-codex.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "The Codex: feats, legendaries and lore"}
  ]
}
